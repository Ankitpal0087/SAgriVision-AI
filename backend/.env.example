# Local MongoDB example (replace only for local development)
MONGODB_URI=mongodb://127.0.0.1:27017/sagrivision
MONGODB_DB=sagrivision

# Local service settings
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
ML_API_URL=http://127.0.0.1:8001
PYTHON_BIN=python

# Authentication / SMTP settings
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# Internal Disease Detection Flask service
DISEASE_API_URL=http://127.0.0.1:5055
DISEASE_PYTHON_BIN=python
DISEASE_TIMEOUT_MS=30000
LEAF_THRESHOLD=.995
UNCERTAIN_LEAF_FLOOR=.85
CROP_THRESHOLD=.70
CROP_MARGIN=.20
DISEASE_THRESHOLD=.95
DISEASE_MARGIN=.20

# Internal CropGPT service settings
# These credentials are forwarded only to CropGPT by scripts/dev.mjs.
CROPGPT_API_URL=http://127.0.0.1:8002
CROPGPT_PYTHON_BIN=python
CROPGPT_TIMEOUT_MS=30000
GROQ_API_KEY=
GROQ_MODEL=

# Internal Crop Advisor / Yield Prediction service settings
# scripts/dev.mjs supplies the child HOST, PORT, and API_KEY at startup.
CROP_ADVISOR_API_URL=http://127.0.0.1:5000
CROP_ADVISOR_API_KEY=
CROP_ADVISOR_PYTHON_BIN=D:/crop_advisor/.venv/Scripts/python.exe
CROP_ADVISOR_TIMEOUT_MS=30000
RATE_LIMIT_PER_MIN=120

