# Copy to .env and edit. Never commit .env.
FLASK_ENV=production
SECRET_KEY=change-me-to-a-long-random-string
# Optional: if set, every /api/* request must send header  X-API-Key: <value>
# (leave empty for the bundled web UI, which cannot keep a secret key)
API_KEY=
RATE_LIMIT_PER_MIN=120
HOST=127.0.0.1
PORT=5000
